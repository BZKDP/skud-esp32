# === Сервер SKUD (server-skud) ===
# Адрес/хост сервера (без схемы), используется скриптами и мостами
SKUD_SERVER_HOST=
SKUD_SERVER_URL=http://localhost:8097

# Доступы к API/веб-кнопке
SKUD_DEVICE_TOKEN=
SKUD_DOOR_PIN=
SKUD_ADMIN_PASSWORD=
SKUD_SESSION_SECRET=
SKUD_CAM_TOKEN=
SKUD_PEOPLE_TOKEN=

# Яндекс.Карты JS API (опционально, для панорам)
SKUD_YMAPS_KEY1=
SKUD_YMAPS_KEY2=

# === MediaMTX (видеопоток камер) ===
SKUD_MTX_USER=camview
SKUD_MTX_PASS=

# === S3-хранилище записей и фото (S3-совместимое) ===
S3_HOST=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === IP-камера (RTSP), для диагностических скриптов pi-bridge ===
CAM_HOST=
CAM_USER=admin
CAM_PASSWORD=

# === Прошивка ESP32 (значения проставляются в скетче перед сборкой) ===
WIFI_SSID=
WIFI_PASSWORD=
OTA_PASSWORD=

# === Планировщик Windows (регистрация задачи выгрузки записей) ===
SKUD_TASK_PASSWORD=
